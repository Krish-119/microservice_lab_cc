# PostgreSQL superuser (used by pgAdmin)
POSTGRES_PASSWORD=supersecret

# Per-service DB credentials
AGENT_DB_USER=agentuser
AGENT_DB_PASSWORD=agentpass

USAGE_DB_USER=usageuser
USAGE_DB_PASSWORD=usagepass

COST_DB_USER=costuser
COST_DB_PASSWORD=costpass

# Postgres host port (exposed to Windows for pgAdmin)
POSTGRES_HOST_PORT=5432

# Service URLs (used by agent-service and usage-service)
USAGE_SERVICE_URL=http://usage-service:8000
COST_SERVICE_URL=http://cost-service:8000

# Model mode: mock or ollama
MODEL_MODE=mock

# Scale factor for mock latency (1.0 = normal)
MOCK_LATENCY_SCALE=1.0

# Ollama URL (only used when MODEL_MODE=ollama)
OLLAMA_URL=http://host.docker.internal:11434

# Timezone for budget date calculations
TZ=Asia/Kolkata
